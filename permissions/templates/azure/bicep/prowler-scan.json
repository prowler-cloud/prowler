{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "10591927438861815055"
    }
  },
  "parameters": {
    "applicationName": {
      "type": "string",
      "defaultValue": "ProwlerApp",
      "metadata": {
        "description": "Name for the App Registration Prowler will use. Keep the default unless you need a custom name."
      }
    },
    "certificateBase64": {
      "type": "securestring",
      "metadata": {
        "description": "Paste the PUBLIC certificate from the Prowler wizard (prowler-cert-base64.txt) or your own openssl output. Prowler never receives the matching private key."
      }
    },
    "certificateDisplayName": {
      "type": "string",
      "defaultValue": "Prowler Certificate",
      "metadata": {
        "description": "Label for the certificate inside the App Registration. Cosmetic — keep the default if unsure."
      }
    },
    "certificateStartDateTime": {
      "type": "string",
      "defaultValue": "[utcNow()]",
      "metadata": {
        "description": "When the certificate becomes valid. Defaults to now."
      }
    },
    "certificateEndDateTime": {
      "type": "string",
      "defaultValue": "[dateTimeAdd(parameters('certificateStartDateTime'), 'P1Y')]",
      "metadata": {
        "description": "When the certificate expires. Defaults to 1 year after certificateStartDateTime. Rotate before this date."
      }
    },
    "customRoleName": {
      "type": "string",
      "defaultValue": "ProwlerRole",
      "metadata": {
        "description": "Name of the extra role Prowler creates. Keep the default unless your org already uses this name."
      }
    }
  },
  "variables": {
    "customRoleDefinitionName": "[guid(subscription().id, parameters('customRoleName'))]",
    "readerRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]"
  },
  "imports": {
    "microsoftGraphV1": {
      "provider": "MicrosoftGraph",
      "version": "1.0.0"
    }
  },
  "resources": {
    "application": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/applications@v1.0",
      "properties": {
        "uniqueName": "[format('{0}-{1}', parameters('applicationName'), subscription().subscriptionId)]",
        "displayName": "[parameters('applicationName')]",
        "description": "Deployed by Prowler quick-start Bicep template for read-only security scanning.",
        "signInAudience": "AzureADMyOrg",
        "keyCredentials": [
          {
            "displayName": "[parameters('certificateDisplayName')]",
            "type": "AsymmetricX509Cert",
            "usage": "Verify",
            "key": "[parameters('certificateBase64')]",
            "startDateTime": "[parameters('certificateStartDateTime')]",
            "endDateTime": "[parameters('certificateEndDateTime')]"
          }
        ]
      }
    },
    "servicePrincipal": {
      "import": "microsoftGraphV1",
      "type": "Microsoft.Graph/servicePrincipals@v1.0",
      "properties": {
        "appId": "[reference('application').appId]",
        "displayName": "[parameters('applicationName')]"
      },
      "dependsOn": [
        "application"
      ]
    },
    "prowlerRole": {
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-05-01-preview",
      "name": "[variables('customRoleDefinitionName')]",
      "properties": {
        "roleName": "[parameters('customRoleName')]",
        "description": "Role used by Prowler for checks that require read-only access to Azure resources beyond the built-in Reader role.",
        "type": "CustomRole",
        "assignableScopes": [
          "[subscription().id]"
        ],
        "permissions": [
          {
            "actions": [
              "Microsoft.Web/sites/host/listkeys/action",
              "Microsoft.Web/sites/config/list/Action"
            ],
            "notActions": [],
            "dataActions": [],
            "notDataActions": []
          }
        ]
      }
    },
    "readerAssignment": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, parameters('applicationName'), 'Reader')]",
      "properties": {
        "principalId": "[reference('servicePrincipal').id]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('readerRoleDefinitionId')]"
      },
      "dependsOn": [
        "servicePrincipal"
      ]
    },
    "prowlerRoleAssignment": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(subscription().id, parameters('applicationName'), parameters('customRoleName'))]",
      "properties": {
        "principalId": "[reference('servicePrincipal').id]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('customRoleDefinitionName'))]"
      },
      "dependsOn": [
        "prowlerRole",
        "servicePrincipal"
      ]
    }
  },
  "outputs": {
    "tenantId": {
      "type": "string",
      "value": "[subscription().tenantId]"
    },
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "applicationId": {
      "type": "string",
      "value": "[reference('application').appId]"
    },
    "servicePrincipalObjectId": {
      "type": "string",
      "value": "[reference('servicePrincipal').id]"
    },
    "certificateThumbprint": {
      "type": "string",
      "value": "[reference('application').keyCredentials[0].customKeyIdentifier]"
    },
    "prowlerRoleDefinitionId": {
      "type": "string",
      "value": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('customRoleDefinitionName'))]"
    }
  }
}