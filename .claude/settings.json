{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run healthcheck)",
      "Bash(pnpm run lint:check)",
      "Bash(pnpm run lint:knip)",
      "Bash(pnpm run test:integration:*)",
      "Bash(pnpm run test:unit:*)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm exec vitest run:*)"
    ]
  }
}
