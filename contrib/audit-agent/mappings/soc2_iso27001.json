      "iso27001": ["A.8.24"]
    },
    {
      "match": ["log", "cloudtrail", "audit", "monitoring", "flow.log"],
      "soc2": ["CC7.2"],
      "iso27001": ["A.8.15"]
    },
    {
      "match": ["iam", "admin", "root", "privilege", "mfa", "password", "policy"],
      "soc2": ["CC6.1", "CC6.3"],
      "iso27001": ["A.5.15", "A.5.18"]
    },
    {
      "match": ["backup", "retention", "versioning", "deletion"],
