  "github_rules": [
    {
      "match": ["secret_scanning", "secret.scanning"],
      "soc2": ["CC6.1"],
      "iso27001": ["A.8.24"],
      "aspect": "secrets"
    },
    {
      "match": ["dependency_scanning", "dependabot", "dependency"],
      "soc2": ["CC7.1"],
      "iso27001": ["A.8.8"],
      "aspect": "dependencies"
    },
    {
      "match": ["branch_protection", "force_push", "status_checks", "signed_commits", "codeowners", "multiple_approvals", "dismisses_stale", "linear_history", "conversation_resolution", "deletion_disabled", "protection_applies"],
      "soc2": ["CC8.1"],
      "iso27001": ["A.8.9"],
      "aspect": "change-management"
    },
    {
      "match": ["mfa", "permission_strict", "repository_creation", "repository_deletion"],
      "soc2": ["CC6.1", "CC6.3"],
      "iso27001": ["A.5.15", "A.5.18"],
      "aspect": "access-control"
    },
    {
      "match": ["githubactions", "workflow_security"],
      "soc2": ["CC7.1", "CC8.1"],
      "iso27001": ["A.8.8", "A.8.9"],
      "aspect": "ci-cd"
    },
    {
      "match": ["inactive_not_archived", "delete_on_merge"],
      "soc2": ["CC8.1"],
      "iso27001": ["A.8.9"],
      "aspect": "repository-hygiene"
    }
  ],
  "misconfig_rules": [
    {
      "match": ["network", "public", "0.0.0.0", "ingress", "ssh", "security.group", "firewall", "nacl"],
